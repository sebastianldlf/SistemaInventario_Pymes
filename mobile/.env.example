# Vacío = automático: la app usa la IP de la PC que corre `npx expo start` (la misma del QR)
# y el puerto EXPO_PUBLIC_API_PORT. No hay que cambiar nada al cambiar de red Wi-Fi.
# Defínela solo para forzar otra URL: túnel HTTPS (https://xxxx.trycloudflare.com),
# Android emulator (http://10.0.2.2:3002) o un backend en otra máquina.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=3002
# Solo si el backend define API_KEY
EXPO_PUBLIC_API_KEY=
