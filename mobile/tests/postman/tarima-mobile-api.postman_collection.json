{
  "info": {
    "_postman_id": "a7c4e910-5c8b-4a2e-9b1f-102938475601",
    "name": "Tarima Mobile - API Contract Tests",
    "description": "Pruebas de contrato y priorización P0/P1 para los endpoints consumidos por tarima-mobile (GET /api/inventory y POST /api/movements).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[P0] GET /api/inventory - Obtener resumen de inventario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('[P0] Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('[P0] Respuesta JSON contiene rows, categories y warehouses', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('rows').that.is.an('array');",
              "    pm.expect(json).to.have.property('categories').that.is.an('array');",
              "    pm.expect(json).to.have.property('warehouses').that.is.an('array');",
              "});",
              "",
              "pm.test('[P0] Estructura de fila de inventario válida para móvil', function () {",
              "    const json = pm.response.json();",
              "    if (json.rows.length > 0) {",
              "        const row = json.rows[0];",
              "        pm.expect(row).to.have.all.keys(",
              "            'id', 'sku', 'barcode', 'name', 'unitOfMeasure',",
              "            'categoryId', 'categoryName', 'minStock', 'averageCost',",
              "            'salePrice', 'totalStock', 'stockByWarehouse', 'status'",
              "        );",
              "        pm.expect(['NORMAL', 'REORDER']).to.include(row.status);",
              "        pm.environment.set('productId', row.id);",
              "    }",
              "    if (json.warehouses.length > 0) {",
              "        pm.environment.set('warehouseId', json.warehouses[0].id);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "disabled": false
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/inventory",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "inventory"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[P0] POST /api/movements - Entrada por compra (PURCHASE_RECEIPT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('[P0] Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('[P0] Movimiento aceptado retorna ok:true y datos de Kardex', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.ok).to.eql(true);",
              "    pm.expect(json.data).to.have.property('kardexId');",
              "    pm.expect(json.data).to.have.property('balanceQuantity').that.is.a('number');",
              "    pm.expect(json.data).to.have.property('averageCost').that.is.a('number');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"movementType\": \"PURCHASE_RECEIPT\",\n  \"quantity\": 5,\n  \"unitCost\": 12.50,\n  \"referenceNote\": \"FAC-001-NEWMAN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/movements",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movements"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[P0] POST /api/movements - Salida por venta (SALE_DISPATCH)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('[P0] Status code es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('[P0] Salida registrada correctamente', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.ok).to.eql(true);",
              "    pm.expect(json.data.kardexId).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"movementType\": \"SALE_DISPATCH\",\n  \"quantity\": 2,\n  \"referenceNote\": \"BOL-102-NEWMAN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/movements",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movements"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[P1] POST /api/movements - Rechazo por cantidad inválida (422/400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('[P1] Status code es 400 o 422', function () {",
              "    pm.expect([400, 422]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('[P1] Respuesta de error cumple ActionResult { ok: false, error }', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.ok).to.eql(false);",
              "    pm.expect(json.error).to.be.a('string').and.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"movementType\": \"PURCHASE_RECEIPT\",\n  \"quantity\": -5,\n  \"referenceNote\": \"INVALIDO\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/movements",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movements"
          ]
        }
      },
      "response": []
    }
  ]
}
